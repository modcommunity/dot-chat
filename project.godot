; dot-chat — text chat as a server-authoritative system.
;
; The distributable is `addons/dot_chat/`. This project exists so the addon can
; be opened and validated standalone.
;
; `addons/dot_core/` is a LOCAL SYMLINK to ../dot-core/addons/dot_core and is
; gitignored — dot-core is a separate repository. See CLAUDE.md.

config_version=5

[application]

config/name="dot-chat"
config/description="Text chat with channels, sanitisation, rate limits and scrollback. The server decides who hears a line, what it may contain and what name is drawn beside it."
config/version="0.1.0"
run/main_scene="res://examples/chat_selftest.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900

[editor_plugins]

enabled=PackedStringArray("res://addons/dot_core/plugin.cfg", "res://addons/dot_chat/plugin.cfg")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
